{
  "name": "grande-amore-ratings",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "vars": {
    "ELO_K": "16",
    "APPLY_RONALDO_20261018": "true",
    "APPLY_TOURNAMENT_20261011": "true",
    "ALLOWED_ORIGIN": "https://andrelgesing.github.io"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RANKINGS",
        "class_name": "Rankings"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Rankings"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "55 21 * * *",
      "55 22 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
